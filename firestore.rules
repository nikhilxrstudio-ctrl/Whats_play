rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS COLLECTION ─────────────────────────────────────────────
    // Supports both signed-in Google users (uid) and guest listeners (device_*)
    // Allows reading and updating profiles, guest display names, and FCM tokens.
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── BLENDS COLLECTION ────────────────────────────────────────────
    // Collaborative real-time listening rooms (Blend)
    match /blends/{blendId} {
      // Anyone with the app can query by 6-digit code, join, or listen to playback
      allow read: if true;

      // Creating, joining, and updating live playback sync
      allow create, update: if true;

      // Only host or signed-in users can delete
      allow delete: if request.auth != null;

      // ── BLEND TRACK QUEUE SUBCOLLECTION ───────────────────────────
      // Tracks added to the shared room playlist
      match /tracks/{trackId} {
        allow read, write: if true;
      }
    }

    // ── MAIL COLLECTION ──────────────────────────────────────────────
    // Queued email templates (Trigger Email extension or client notifications)
    match /mail/{mailId} {
      allow create: if true;
      allow read: if false;
    }

    // ── EMAIL LOGS COLLECTION ────────────────────────────────────────
    // Dispatched email audit logs, delivery status, and history for Admin Panel
    match /email_logs/{logId} {
      allow read, write: if true;
    }

    // ── EMAIL TEMPLATES COLLECTION ───────────────────────────────────
    // Saved email templates (New Releases, Changelogs, Announcements)
    match /email_templates/{templateId} {
      allow read, write: if true;
    }

    // ── PUSH NOTIFICATION LOGS COLLECTION ────────────────────────────
    // Dispatched push alerts, topic broadcasts, and FCM delivery logs for Admin Panel
    match /notification_logs/{notifId} {
      allow read, write: if true;
    }

    // ── APK DOWNLOADS COLLECTION ─────────────────────────────────────
    // Download telemetry, visitor geolocation, device model, and OS analytics
    match /apk_downloads/{downloadId} {
      allow read, write: if true;
    }

  }
}
